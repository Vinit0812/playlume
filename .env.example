# ==============================================
# PLAYLUME B2B WHOLESALE PLATFORM
# Environment Variables Template
# ==============================================
# Copy this file to .env.local and fill in values
# NEVER commit .env.local to git

# --- DATABASE ---
DATABASE_URL="mysql://username:password@localhost:3306/playlume_db"
DATABASE_URL_DEV="mysql://username:password@localhost:3306/playlume_dev"
DATABASE_URL_STAGE="mysql://username:password@host:3306/playlume_stage"

# --- NEXT AUTH ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-min-32-chars"

# --- CLOUDINARY ---
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# --- WHATSAPP ---
NEXT_PUBLIC_WHATSAPP_NUMBER="91XXXXXXXXXX"
NEXT_PUBLIC_WHATSAPP_DEFAULT_MSG="Hello, I am interested in your wholesale products."

# --- BUSINESS INFO ---
NEXT_PUBLIC_BUSINESS_NAME="PLAYLUME"
NEXT_PUBLIC_BUSINESS_EMAIL="info@playlume.in"
NEXT_PUBLIC_BUSINESS_PHONE="+91XXXXXXXXXX"
NEXT_PUBLIC_BUSINESS_ADDRESS="Your City, India"

# --- GOOGLE ANALYTICS ---
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# --- META PIXEL ---
NEXT_PUBLIC_META_PIXEL_ID=""

# --- ADMIN ---
ADMIN_EMAIL="admin@playlume.in"

# --- APP ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
